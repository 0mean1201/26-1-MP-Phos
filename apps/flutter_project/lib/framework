/// 1. 프레임 레이아웃 종류 정의
enum FrameType {
  grid2x2,  // 2x2 격자 형태 (총 4장)
  strip1x4, // 1x4 세로 스트립 (총 4장)
  strip1x3, // 1x3 세로 스트립 (총 3장)
}

/// 2. 커스텀 프레임 디자인 모델
class FrameDesign {
  final String id;
  final String name;
  final Color fallbackColor;     // 이미지 로드 실패 시 보정용 배경색
  final String? assetImagePath;  // [핵심] 사용자가 직접 디자인한 구멍 뚫린 PNG 프레임 (Assets 경로)

  FrameDesign({
    required this.id,
    required this.name,
    required this.fallbackColor,
    this.assetImagePath,
  });
}

/// 3. 사진 슬롯을 아래에 깔고, 그 위에 직접 만든 프레임 이미지를 오버레이하는 핵심 위젯
class CustomFourCutFrame extends StatelessWidget {
  final List<File?> images;              // 입력받은 사진 리스트
  final FrameType frameType;             // 선택된 레이아웃 형태
  final FrameDesign design;              // 선택된 커스텀 프레임 디자인
  final Function(int index)? onPhotoTap; // 개별 칸 선택 시 액션 (편집용)
  final int? currentCaptureIndex;         // 현재 촬영 중인 인덱스 (카메라 프리뷰 표시용)
  final Widget? cameraPreviewWidget;      // 실시간 카메라 프리뷰 위젯 인입용

  const CustomFourCutFrame({
    Key? key,
    required this.images,
    required this.frameType,
    required this.design,
    this.onPhotoTap,
    this.currentCaptureIndex,
    this.cameraPreviewWidget,
  }) : super(key: key);

  // 레이아웃 별 프레임 실제 해상도/크기 비율 고정 (인생네컷 표준 비율 반영)
  Size _getFrameSize() {
    switch (frameType) {
      case FrameType.grid2x2:
        return const Size(320, 430);
      case FrameType.strip1x4:
        return const Size(150, 520);
      case FrameType.strip1x3:
        return const Size(150, 400);
    }
  }

  // 각 프레임 레이아웃에 맞는 사진 비율 및 여백 설정 내부 패딩
  EdgeInsets _getInternalPadding() {
    switch (frameType) {
      case FrameType.grid2x2:
        return const EdgeInsets.fromLTRB(14, 16, 14, 55); // 아래 브랜드 로고 영역 확보
      case FrameType.strip1x4:
        return const EdgeInsets.fromLTRB(10, 12, 10, 50);
      case FrameType.strip1x3:
        return const EdgeInsets.fromLTRB(10, 12, 10, 45);
    }
  }

  @override
  Widget build(BuildContext context) {
    final frameSize = _getFrameSize();

    return Container(
      width: frameSize.width,
      height: frameSize.height,
      color: design.fallbackColor, // 기본 베이스 배경색
      child: Stack(
        children: [
          // [레이어 1] 실제 사진 및 카메라 프리뷰가 배치되는 하부 레이아웃
          Padding(
            padding: _getInternalPadding(),
            child: _buildPhotosLayout(),
          ),

          // [레이어 2] 직접 제작한 구멍 뚫린 PNG 프레임 이미지를 위에 덮어버림
          if (design.assetImagePath != null)
            Positioned.fill(
              child: IgnorePointer(
                // 프레임 이미지가 터치 이벤트를 막지 않도록 설정하여 사진 칸 클릭 유효화
                child: Image.asset(
                  design.assetImagePath!,
                  fit: BoxFit.fill,
                ),
              ),
            ),
        ],
      ),
    );
  }

  /// 프레임 레이아웃 배치 로직
  Widget _buildPhotosLayout() {
    switch (frameType) {
      case FrameType.grid2x2:
        return Column(
          children: [
            Expanded(
              child: Row(
                children: [
                  Expanded(child: _buildPhotoCell(0)),
                  const SizedBox(width: 8),
                  Expanded(child: _buildPhotoCell(1)),
                ],
              ),
            ),
            const SizedBox(height: 10),
            Expanded(
              child: Row(
                children: [
                  Expanded(child: _buildPhotoCell(2)),
                  const SizedBox(width: 8),
                  Expanded(child: _buildPhotoCell(3)),
                ],
              ),
            ),
          ],
        );

      case FrameType.strip1x4:
        return Column(
          children: [
            Expanded(child: _buildPhotoCell(0)),
            const SizedBox(height: 6),
            Expanded(child: _buildPhotoCell(1)),
            const SizedBox(height: 6),
            Expanded(child: _buildPhotoCell(2)),
            const SizedBox(height: 6),
            Expanded(child: _buildPhotoCell(3)),
          ],
        );

      case FrameType.strip1x3:
        return Column(
          children: [
            Expanded(child: _buildPhotoCell(0)),
            const SizedBox(height: 6),
            Expanded(child: _buildPhotoCell(1)),
            const SizedBox(height: 6),
            Expanded(child: _buildPhotoCell(2)),
          ],
        );
    }
  }

  /// 개별 사진 영역 프레임 셸 빌더 (촬영 중에는 해당 칸에 실시간 프리뷰 삽입)
  Widget _buildPhotoCell(int index) {
    final File? imgFile = (index < images.length) ? images[index] : null;

    // 만약 현재 촬영해야 하는 인덱스이고 카메라 프리뷰 위젯이 존재한다면 뷰파인더 꽂아주기
    if (currentCaptureIndex == index && cameraPreviewWidget != null) {
      return Container(
        color: Colors.black,
        child: cameraPreviewWidget,
      );
    }

    return GestureDetector(
      onTap: onPhotoTap != null ? () => onPhotoTap!(index) : null,
      child: Container(
        color: const Color(0xFFEEEEEE), // 빈 슬롯 상태의 기본 회색 배경
        child: imgFile != null
            ? Image.file(
                imgFile,
                fit: BoxFit.cover,
                width: double.infinity,
                height: double.infinity,
              )
            : const Center(
                child: Icon(
                  Icons.camera_alt_outlined,
                  color: Colors.black12,
                  size: 20,
                ),
              ),
      ),
    );
  }
}

/// 4. 프레임 합성 캡처 저장 도구
class FrameCaptureService {
  static Future<File?> saveFrameAsImage(GlobalKey repaintKey) async {
    try {
      final boundary = repaintKey.currentContext!.findRenderObject() as RenderRepaintBoundary;

      // 고화질 출력을 보장하기 위해 픽셀 디바이스 배수를 3.0배 고해상도로 캡처진행
      final ui.Image image = await boundary.toImage(pixelRatio: 3.0);
      final ByteData? byteData = await image.toByteData(format: ui.ImageByteFormat.png);

      if (byteData == null) return null;

      final Uint8List pngBytes = byteData.buffer.asUint8List();
      final directory = await getTemporaryDirectory();
      final String filePath = '${directory.path}/life4cuts_${DateTime.now().millisecondsSinceEpoch}.png';
      final File file = File(filePath);

      await file.writeAsBytes(pngBytes);
      return file;
    } catch (e) {
      debugPrint('최종 이미지 합성 디바이스 인코딩 오류: $e');
      return null;
    }
  }
}

/// 5. 인앱 전용 포토부스 촬영 화면 (실시간 커스텀 선택 프레임 연동)
class CameraBoothScreen extends StatefulWidget {
  final int requiredPhotos;  // 촬영해야 하는 총 장수 (3 또는 4)
  final FrameType frameType; // 부모 메인 콘솔로부터 전달받은 레이아웃 종류
  final FrameDesign design;  // 부모 메인 콘솔로부터 전달받은 직접 만든 프레임 디자인

  const CameraBoothScreen({
    Key? key,
    required this.requiredPhotos,
    required this.frameType,
    required this.design,
  }) : super(key: key);

  @override
  State<CameraBoothScreen> createState() => _CameraBoothScreenState();
}

class _CameraBoothScreenState extends State<CameraBoothScreen> {
  List<CameraDescription> _cameras = [];
  CameraController? _cameraController;
  int _selectedCameraIndex = 1; // 기본 디폴트 전면 셀카 렌즈 고정
  bool _isCameraInitialized = false;

  // 촬영 진행 상태 동기화 데이터 세트 (고정 크기 Nullable 리스트 구조화)
  late List<File?> _capturedFiles;
  int _currentCaptureIndex = 0;

  // 타이머 관련 변수
  Timer? _timer;
  int _timerSeconds = 3;
  bool _isCountingDown = false;

  @override
  void initState() {
    super.initState();
    _capturedFiles = List<File?>.filled(widget.requiredPhotos, null);
    _initCameras();
  }

  Future<void> _initCameras() async {
    try {
      _cameras = await availableCameras();
      if (_cameras.isNotEmpty) {
        int frontCamIndex = _cameras.indexWhere(
          (cam) => cam.lensDirection == CameraLensDirection.front,
        );
        _selectedCameraIndex = frontCamIndex != -1 ? frontCamIndex : 0;
        await _startCameraController(_cameras[_selectedCameraIndex]);
      }
    } catch (e) {
      debugPrint('카메라 하드웨어 묘사 실패: $e');
    }
  }

  Future<void> _startCameraController(CameraDescription cameraDescription) async {
    if (_cameraController != null) {
      await _cameraController!.dispose();
    }

    _cameraController = CameraController(
      cameraDescription,
      ResolutionPreset.high,
      enableAudio: false,
    );

    try {
      await _cameraController!.initialize();
      if (mounted) {
        setState(() {
          _isCameraInitialized = true;
        });
      }
    } catch (e) {
      debugPrint('카메라 뷰파인더 초기화 실패: $e');
    }
  }

  @override
  void dispose() {
    _timer?.cancel();
    _cameraController?.dispose();
    super.dispose();
  }

  Future<void> _toggleCamera() async {
    if (_cameras.length < 2) return;
    setState(() {
      _isCameraInitialized = false;
      _selectedCameraIndex = (_selectedCameraIndex + 1) % _cameras.length;
    });
    await _startCameraController(_cameras[_selectedCameraIndex]);
  }

  void _triggerCountdown() {
    if (_isCountingDown || _currentCaptureIndex >= widget.requiredPhotos) return;

    setState(() {
      _isCountingDown = true;
      _timerSeconds = 3;
    });

    _timer = Timer.periodic(const Duration(seconds: 1), (timer) async {
      if (_timerSeconds > 1) {
        setState(() {
          _timerSeconds--;
        });
      } else {
        timer.cancel();
        setState(() {
          _isCountingDown = false;
        });
        await _takePhoto();
      }
    });
  }

  Future<void> _takePhoto() async {
    if (_cameraController == null || !_cameraController!.value.isInitialized) return;

    try {
      final XFile rawPhoto = await _cameraController!.takePicture();
      final File savedFile = File(rawPhoto.path);

      setState(() {
        _capturedFiles[_currentCaptureIndex] = savedFile;
        _currentCaptureIndex++;
      });

      // 지정한 포토수를 전부 촬영 완료했다면 결과물 파일을 묶어서 메인 화면으로 리턴
      if (_currentCaptureIndex >= widget.requiredPhotos) {
        final List<File> nonNullFiles = _capturedFiles.whereType<File>().toList();
        Navigator.pop(context, nonNullFiles);
      }
    } catch (e) {
      debugPrint('셔터 트리거 캡처 에러: $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    // 하드웨어 비율에 맞춰 꽉 차게 크롭 렌더링을 처리하는 뷰파인더 모듈 추출
    Widget? previewWidget;
    if (_isCameraInitialized && _cameraController != null) {
      previewWidget = ClipRect(
        child: OverflowBox(
          alignment: Alignment.center,
          child: FittedBox(
            fit: BoxFit.cover,
            child: SizedBox(
              width: _cameraController!.value.previewSize!.height,
              height: _cameraController!.value.previewSize!.width,
              child: CameraPreview(_cameraController!),
            ),
          ),
        ),
      );
    }

    return Scaffold(
      backgroundColor: const Color(0xFF1A1A1A), // 어두운 촬영룸 연출 배경
      appBar: AppBar(
        backgroundColor: Colors.black,
        iconTheme: const IconThemeData(color: Colors.white),
        title: Text(
          '부스 촬영중 (${_currentCaptureIndex + 1}/${widget.requiredPhotos}컷)',
          style: const TextStyle(color: Colors.white, fontSize: 16),
        ),
        actions: [
          IconButton(
            icon: const Icon(Icons.flip_camera_ios_outlined),
            onPressed: _isCountingDown ? null : _toggleCamera,
          ),
        ],
      ),
      body: _isCameraInitialized
          ? Column(
              children: [
                // 1. 실시간 선택한 구멍 뚫린 내 프레임 안에서 사진 찍는 메인 영역
                Expanded(
                  child: Center(
                    child: SingleChildScrollView(
                      child: Stack(
                        alignment: Alignment.center,
                        children: [
                          // 메인 콘솔에서 미리 선택하고 들어온 프레임을 그대로 띄우고 빈 슬롯에만 카메라 표출
                          CustomFourCutFrame(
                            images: _capturedFiles,
                            frameType: widget.frameType,
                            design: widget.design,
                            currentCaptureIndex: _currentCaptureIndex < widget.requiredPhotos ? _currentCaptureIndex : null,
                            cameraPreviewWidget: previewWidget,
                          ),

                          // 실시간 3, 2, 1 카운트다운 타이머 텍스트 그래픽 오버레이
                          if (_isCountingDown)
                            IgnorePointer(
                              child: AnimatedSwitcher(
                                duration: const Duration(milliseconds: 200),
                                child: Text(
                                  '$_timerSeconds',
                                  key: ValueKey<int>(_timerSeconds),
                                  style: const TextStyle(
                                    color: Colors.yellowAccent,
                                    fontSize: 110,
                                    fontWeight: FontWeight.w900,
                                    fontStyle: FontStyle.italic,
                                    shadows: [
                                      Shadow(
                                        blurRadius: 15.0,
                                        color: Colors.black,
                                        offset: Offset(3.0, 3.0),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            ),
                        ],
                      ),
                    ),
                  ),
                ),

                // 2. 하단 카메라 물리 셔터 콘솔 제어 바
                Container(
                  color: Colors.black,
                  padding: const EdgeInsets.symmetric(vertical: 24),
                  child: Center(
                    child: ElevatedButton(
                      onPressed: _isCountingDown || _currentCaptureIndex >= widget.requiredPhotos ? null : _triggerCountdown,
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.white,
                        foregroundColor: Colors.black,
                        shape: const CircleBorder(),
                        padding: const EdgeInsets.all(22),
                      ),
                      child: const Icon(Icons.camera, size: 36),
                    ),
                  ),
                ),
              ],
            )
          : const Center(
              child: CircularProgressIndicator(
                valueColor: AlwaysStoppedAnimation<Color>(Colors.white),
              ),
            ),
    );
  }
}

/// 6. 실제 사용 및 조합 완성 메인 제어판 (카메라 구동 전 미리 프레임 테마 에디팅)
class LifeFourCutsCreatorScreen extends StatefulWidget {
  const LifeFourCutsCreatorScreen({Key? key}) : super(key: key);

  @override
  State<LifeFourCutsCreatorScreen> createState() => _LifeFourCutsCreatorScreenState();
}

